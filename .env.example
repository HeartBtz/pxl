# Docker image/build and published HTTP endpoint
PXL_VERSION=latest
PXL_BIND_ADDRESS=127.0.0.1
PXL_PORT=8080
PXL_BASE_URL=http://localhost:8080

# Required secrets. Leave empty in source control and set unique values in .env.
PXL_DB_PASS=
PXL_JWT_SECRET=
PXL_ADMIN_PASS=
PXL_ADMIN_USERNAME=admin

# Access is closed by default.
PXL_ALLOW_ANONYMOUS=false
PXL_ALLOW_REGISTRATION=false
PXL_JWT_EXPIRY=15m
PXL_REFRESH_EXPIRY=168h
PXL_DEFAULT_QUOTA_BYTES=1073741824
PXL_DEFAULT_QUOTA_IMAGES=5000

# Storage: local or s3
PXL_STORAGE_BACKEND=local
PXL_STORAGE_S3_ENDPOINT=
PXL_STORAGE_S3_REGION=us-east-1
PXL_STORAGE_S3_BUCKET=
PXL_STORAGE_S3_ACCESS_KEY=
PXL_STORAGE_S3_SECRET_KEY=
PXL_STORAGE_S3_USE_SSL=true
PXL_STORAGE_S3_FORCE_PATH_STYLE=false

# Uploads and thumbnails
PXL_MAX_UPLOAD_SIZE=52428800
PXL_MAX_UPLOAD_FILES=10
PXL_MAX_PIXELS=40000000
PXL_UPLOAD_MIN_FREE_BYTES=1073741824
PXL_UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp
PXL_THUMB_ENABLED=true
PXL_THUMB_WORKERS=2
PXL_THUMB_SIZE=300
PXL_THUMB_QUALITY=85

# Proxy, CORS, rate limits, metrics, and logs
PXL_TRUSTED_PROXIES=
PXL_CORS_ORIGIN=
PXL_RATE_LIMIT_REQUESTS=60
PXL_PUBLIC_RATE_LIMIT_REQUESTS=600
PXL_RATE_LIMIT_WINDOW=1m
PXL_METRICS_ENABLED=true
PXL_METRICS_PORT=9090
PXL_LOG_LEVEL=info
PXL_LOG_FORMAT=json
